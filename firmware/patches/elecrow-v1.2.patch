+/**
+   @brief       Upload the retained old frame and new frame for a low-flicker update
+   @param       PreviousImageBW: frame currently visible on the panel
+   @param       ImageBW: replacement frame
+*/
+void EPD_DisplayTransition(const uint8_t *PreviousImageBW, const uint8_t *ImageBW)
+{
+  unsigned int i;
+
+  EPD_WR_REG(0x50);
+  EPD_WR_DATA8(0xD7);
+
+  EPD_WR_REG(0x10);       /* Transfer OLD data */
+  for (i = 0; i < EPD_W * EPD_H / 8; i++)
+  {
+      EPD_WR_DATA8(*PreviousImageBW);
+      PreviousImageBW++;
+  }
+
+  EPD_WR_REG(0x13);       /* Transfer NEW data */
+  for (i = 0; i < EPD_W * EPD_H / 8; i++)
+  {
+      EPD_WR_DATA8(*ImageBW);
+      ImageBW++;
+  }
+  lut_DU();
+}
+
